{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gnost.readthedocs.io/schemas/insights-1.3.json",
  "title": "GNOST onboarding insights",
  "description": "Output of `gnost onboard --json`. Paths are relative to the scanned root. Version 1.x only adds fields; consumers must ignore unknown fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "project",
    "entry_points",
    "routes",
    "layers",
    "first_files",
    "hotspots",
    "caution_areas",
    "cycles",
    "graph",
    "stats",
    "flows",
    "callgraph"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "gnost"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "languages",
        "framework",
        "files"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "languages": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "framework": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "parsers": {
          "type": "object",
          "description": "How each language's files are read: `ast` (Python), `tree-sitter`, or `regex` when no grammar is available on this machine.",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "ast",
              "tree-sitter",
              "regex"
            ]
          }
        }
      }
    },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "reason",
          "priority"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "primary",
              "secondary"
            ]
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "path",
          "handler",
          "file",
          "line",
          "framework"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "handler": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "framework": {
            "type": "string"
          }
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "core",
        "leaf"
      ],
      "properties": {
        "entry": {
          "$ref": "#/definitions/paths"
        },
        "core": {
          "$ref": "#/definitions/paths"
        },
        "leaf": {
          "$ref": "#/definitions/paths"
        }
      }
    },
    "first_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason",
          "score"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      }
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "score",
          "fan_in",
          "fan_out",
          "depth",
          "layer"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "fan_in": {
            "type": "integer",
            "minimum": 0
          },
          "fan_out": {
            "type": "integer",
            "minimum": 0
          },
          "depth": {
            "type": "integer",
            "minimum": 0
          },
          "layer": {
            "type": "string"
          }
        }
      }
    },
    "caution_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "category",
          "severity",
          "description",
          "metrics",
          "score",
          "partial",
          "factors"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "category": {
            "enum": [
              "high_impact",
              "large_file",
              "tight_coupling",
              "circular_dependency",
              "high_complexity",
              "low_observability"
            ]
          },
          "severity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "description": {
            "type": "string"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "partial": {
            "type": "boolean"
          },
          "factors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value",
                "contribution",
                "estimated"
              ],
              "properties": {
                "name": {
                  "enum": [
                    "cycles",
                    "size",
                    "impact",
                    "coupling",
                    "complexity",
                    "observability"
                  ]
                },
                "value": {
                  "type": "number"
                },
                "contribution": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "estimated": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "files",
          "example"
        ],
        "properties": {
          "kind": {
            "enum": [
              "import-time",
              "deferred"
            ]
          },
          "files": {
            "$ref": "#/definitions/paths"
          },
          "example": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "$ref": "#/definitions/paths"
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "deferred"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "deferred": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "entry_points",
        "routes",
        "reachable_files",
        "edges",
        "cycles_import_time",
        "cycles_deferred"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "entry_points": {
          "type": "integer",
          "minimum": 0
        },
        "reachable_files": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "cycles_import_time": {
          "type": "integer",
          "minimum": 0
        },
        "cycles_deferred": {
          "type": "integer",
          "minimum": 0
        },
        "routes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "label",
          "size",
          "truncated",
          "entry"
        ],
        "properties": {
          "kind": {
            "enum": [
              "route",
              "main"
            ]
          },
          "label": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "truncated": {
            "type": "boolean"
          },
          "entry": {
            "$ref": "#/definitions/call"
          }
        }
      }
    },
    "callgraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functions",
        "edges",
        "unparsed_files"
      ],
      "properties": {
        "functions": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "unparsed_files": {
          "$ref": "#/definitions/paths"
        }
      }
    },
    "change_history": {
      "type": "object",
      "description": "Change hotspots from git history. `available` is false (with a `reason`) when there is no usable history.",
      "required": [
        "available",
        "reason",
        "window_days",
        "commits_analyzed",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "window_days": {
          "type": "integer",
          "minimum": 0
        },
        "commits_analyzed": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "score",
              "commits",
              "authors",
              "recent_commits",
              "lines_added",
              "lines_removed",
              "last_changed"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "commits": {
                "type": "integer",
                "minimum": 1
              },
              "authors": {
                "type": "integer",
                "minimum": 1
              },
              "recent_commits": {
                "type": "integer",
                "minimum": 0
              },
              "lines_added": {
                "type": "integer",
                "minimum": 0
              },
              "lines_removed": {
                "type": "integer",
                "minimum": 0
              },
              "last_changed": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "description": "Files that are both fragile to change (caution score) and changing often (change hotspots). Empty without git history.",
      "required": [
        "threshold",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "risk",
              "structural_score",
              "change_score",
              "commits",
              "authors",
              "recent_commits",
              "reasons"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "risk": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "structural_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "change_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "commits": {
                "type": "integer",
                "minimum": 1
              },
              "authors": {
                "type": "integer",
                "minimum": 1
              },
              "recent_commits": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "quickstart": {
      "type": "object",
      "description": "How to install, build, run and test the project, read from its own files. Each step names its source file; nothing is guessed.",
      "required": [
        "prerequisites",
        "install",
        "build",
        "run",
        "test",
        "environment"
      ],
      "additionalProperties": false,
      "properties": {
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "source",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "command": {
                "type": "boolean"
              }
            }
          }
        },
        "install": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "source",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "command": {
                "type": "boolean"
              }
            }
          }
        },
        "build": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "source",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "command": {
                "type": "boolean"
              }
            }
          }
        },
        "run": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "source",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "command": {
                "type": "boolean"
              }
            }
          }
        },
        "test": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "source",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "command": {
                "type": "boolean"
              }
            }
          }
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "source",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "command": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "description": "Result of the `[architecture]` rules in .gnost.toml: imports that break a layer order or a forbidden-import rule. `configured` is false when there are no rules.",
      "required": [
        "configured",
        "rules",
        "edges_checked",
        "fail",
        "violations"
      ],
      "additionalProperties": false,
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "rules": {
          "type": "integer",
          "minimum": 0
        },
        "edges_checked": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "source",
              "target",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "rule": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function",
        "file",
        "line",
        "repeat",
        "calls"
      ],
      "properties": {
        "function": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "repeat": {
          "type": "boolean"
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/call"
          }
        }
      }
    }
  }
}
