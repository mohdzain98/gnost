<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.mohdzain98</groupId>
    <artifactId>gnost-parent</artifactId>
    <version>0.5.0-SNAPSHOT</version>
  </parent>

  <artifactId>gnost-binary</artifactId>
  <packaging>pom</packaging>

  <name>GNOST binary</name>
  <description>Standalone GNOST executables, one zip per platform (classifiers darwin-arm64, linux-x64, windows-x64).</description>

  <!--
    The zips are produced by scripts/build_maven.py into ./binaries from the same
    PyInstaller builds that npm uses. Each profile attaches the zip if it exists,
    so a release without one platform simply has no artifact for it.
  -->
  <profiles>
    <profile>
      <id>darwin-arm64</id>
      <activation><file><exists>${basedir}/binaries/darwin-arm64.zip</exists></file></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions><execution>
          <id>attach-darwin-arm64</id>
          <phase>package</phase>
          <goals><goal>attach-artifact</goal></goals>
          <configuration><artifacts><artifact>
            <file>${basedir}/binaries/darwin-arm64.zip</file>
            <type>zip</type>
            <classifier>darwin-arm64</classifier>
          </artifact></artifacts></configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>linux-x64</id>
      <activation><file><exists>${basedir}/binaries/linux-x64.zip</exists></file></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions><execution>
          <id>attach-linux-x64</id>
          <phase>package</phase>
          <goals><goal>attach-artifact</goal></goals>
          <configuration><artifacts><artifact>
            <file>${basedir}/binaries/linux-x64.zip</file>
            <type>zip</type>
            <classifier>linux-x64</classifier>
          </artifact></artifacts></configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>windows-x64</id>
      <activation><file><exists>${basedir}/binaries/windows-x64.zip</exists></file></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions><execution>
          <id>attach-windows-x64</id>
          <phase>package</phase>
          <goals><goal>attach-artifact</goal></goals>
          <configuration><artifacts><artifact>
            <file>${basedir}/binaries/windows-x64.zip</file>
            <type>zip</type>
            <classifier>windows-x64</classifier>
          </artifact></artifacts></configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
